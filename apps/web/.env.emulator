# Used by `pnpm dev:emulators` and e2e tests. Connects to the local Auth + Firestore
# emulators with a demo project. Firebase AI Logic cloud calls cannot work here
# (there is no real project); on-device inference still works in supported Chrome.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-meetos.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-meetos
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
