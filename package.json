{
  "name": "meetos",
  "private": true,
  "version": "0.1.0",
  "description": "MEETOS \u2014 AI meeting intelligence and execution platform (Firebase AI Logic hybrid inference).",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @meetos/web dev",
    "dev:emulators": "pnpm --filter @meetos/web dev:emulators",
    "build": "pnpm --filter @meetos/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-meetos",
    "test:rules": "firebase emulators:exec --only firestore --project demo-meetos \"pnpm --filter @meetos/firebase-tests test\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-meetos \"pnpm --filter @meetos/web e2e\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.37.0",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "type": "module"
}