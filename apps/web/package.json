{
  "name": "@meetos/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulator",
    "build": "tsc -b && vite build",
    "build:emulator": "tsc -b && vite build --mode emulator",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src e2e",
    "test": "vitest run --passWithNoTests --dir src",
    "e2e": "vite build --mode emulator && playwright test"
  },
  "dependencies": {
    "@meetos/shared": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^13.4.0",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.5"
  }
}
