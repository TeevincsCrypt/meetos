# MEETOS web — copy to .env.local and fill in from:
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase AI Logic backend: "googleai" (Gemini Developer API, default) or "agentplatform" (Vertex AI Gemini API)
VITE_AI_BACKEND=googleai

# App Check (required when you enforce App Check for Firebase AI Logic)
# Set ONE of these (Enterprise wins if both are set):
#  - reCAPTCHA v3: create a key at https://www.google.com/recaptcha/admin/create, then
#    Firebase Console > App Check > Apps > your web app > reCAPTCHA (paste the SECRET key there).
VITE_RECAPTCHA_V3_SITE_KEY=
#  - reCAPTCHA Enterprise: Google Cloud console > Security > reCAPTCHA, then
#    Firebase Console > App Check > Apps > your web app > reCAPTCHA Enterprise.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development only. "true" prints a debug token in the browser console that
# you register in Firebase Console > App Check > Manage debug tokens. Never commit a token.
VITE_APPCHECK_DEBUG=false
